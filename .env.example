# PostgreSQL connection.
# Dev currently runs against Neon (Docker is broken on this machine — see README).
# The value below is the local docker-compose fallback.
DATABASE_URL="postgresql://booking:booking@localhost:5433/booking?schema=public"

# App
PORT=3001
NODE_ENV=development
APP_PUBLIC_URL=http://localhost:3001

# PayPal (payment gateway). Global credentials from the PayPal Developer
# dashboard. PAYPAL_MODE = sandbox | live. PAYPAL_WEBHOOK_ID identifies the
# webhook you created in the dashboard and is REQUIRED to verify POST /webhooks/paypal.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=

# Email: if set, EmailService sends via Resend; if unset it logs to console
# (so local dev is never blocked). The "from" address comes from
# tenant_settings.email_from, not from here.
RESEND_API_KEY=

# Admin panel (/admin/*) — TEMPORARY single-admin HTTP Basic Auth.
# ADMIN_PASSWORD_HASH is a bcrypt hash; the plaintext is never stored.
# Generate a new one: node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD',12))"
# NOTE: replace this sample hash — do NOT ship it. When a 2nd client is added,
# move to a per-tenant `admins` DB table instead of shared env credentials.
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=$2b$12$jD8G39raynr.fDmaPxfNBuPT0ssClPASc044y368hQgb6A0fo3BYm

# Beds24 (Phase 4). Per-tenant credentials (refresh token = beds24_api_key,
# property id = beds24_prop_id, room mapping = rooms.beds24_room_id) live in the DB.
# BEDS24_API_BASE_URL overrides the API host (default https://api.beds24.com/v2).
# BEDS24_WEBHOOK_SECRET (optional): if set, POST /webhooks/beds24?token=... must match.
BEDS24_API_BASE_URL=https://api.beds24.com/v2
BEDS24_WEBHOOK_SECRET=
