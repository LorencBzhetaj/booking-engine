{{> header}}

{{#if ok}}<div class="notice ok">Room {{ok}} successfully.</div>{{/if}}
{{#if error}}
  <div class="notice error">
    {{#if (eq error "has_active_reservations")}}Cannot delete: this room has active (pending/confirmed) reservations.{{else}}{{error}}{{/if}}
  </div>
{{/if}}

<table>
  <thead>
    <tr><th>Name</th><th>Type</th><th>Capacity</th><th>Base price ({{currency}})</th><th></th></tr>
  </thead>
  <tbody>
    {{#each rooms}}
      <tr>
        <form class="inline" method="post" action="/admin/rooms/{{this.id}}?_method=PUT">
          <td><input name="name" value="{{this.name}}" required /></td>
          <td><input name="roomType" value="{{this.roomType}}" required /></td>
          <td><input name="capacity" type="number" min="1" value="{{this.capacity}}" required style="width:70px" /></td>
          <td><input name="basePrice" type="number" step="0.01" min="0" value="{{this.basePrice}}" required style="width:100px" /></td>
          <td class="actions">
            <button type="submit">Save</button>
        </form>
            <form method="post" action="/admin/rooms/{{this.id}}?_method=DELETE" onsubmit="return confirm('Delete room {{this.name}}?')">
              <button class="danger" type="submit">Delete</button>
            </form>
          </td>
      </tr>
    {{else}}
      <tr><td colspan="5" class="muted">No rooms yet.</td></tr>
    {{/each}}
  </tbody>
</table>

<div class="card" style="margin-top:20px">
  <h3 style="margin-top:0">Add room</h3>
  <form class="inline" method="post" action="/admin/rooms">
    <label>Name<input name="name" required /></label>
    <label>Type<input name="roomType" placeholder="double / family" required /></label>
    <label>Capacity<input name="capacity" type="number" min="1" value="2" required /></label>
    <label>Base price<input name="basePrice" type="number" step="0.01" min="0" value="60.00" required /></label>
    <button type="submit">Create</button>
  </form>
</div>

{{> footer}}
