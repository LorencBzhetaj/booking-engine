{{> header}}

{{#if ok}}<div class="notice ok">Reservation {{ok}} successfully.</div>{{/if}}
{{#if error}}<div class="notice error">{{error}}</div>{{/if}}

<form class="filters" method="get" action="/admin/reservations">
  <label>Status
    <select name="status">
      {{#each statuses}}
        <option value="{{this}}" {{selected this ../filter.status}}>{{this}}</option>
      {{/each}}
    </select>
  </label>
  <label>From
    <input type="date" name="from" value="{{filter.from}}" />
  </label>
  <label>To
    <input type="date" name="to" value="{{filter.to}}" />
  </label>
  <label>Search (code / guest)
    <input type="search" name="q" value="{{filter.q}}" placeholder="RES-2026-… / name / email" style="width:200px" />
  </label>
  <button type="submit">Filter</button>
  {{#if filter.q}}<a href="/admin/reservations"><button class="ghost" type="button">Clear</button></a>{{/if}}
</form>

<p class="muted">
  {{#if filter.q}}Showing {{reservations.length}} result(s) for “{{filter.q}}”.
  {{else}}Showing {{reservations.length}} reservation(s) · check-in between {{filter.from}} and {{filter.to}}.{{/if}}
</p>

<table>
  <thead>
    <tr>
      <th>Guest</th><th>Code</th><th>Status</th><th>Payment</th><th>Total ({{currency}})</th>
      <th>Modify (room · dates)</th><th></th>
    </tr>
  </thead>
  <tbody>
    {{#each reservations}}
      <tr class="row-{{this.status}}">
        <td>{{this.guestName}}<br /><span class="muted">{{this.guestEmail}}</span>
          {{#if (eq this.source "beds24")}}<br /><span class="badge s-refunded">OTA</span>{{/if}}
        </td>
        <td><span class="muted" style="font-family:monospace">{{this.confirmationNumber}}</span></td>
        <td><span class="badge s-{{this.status}}">{{this.status}}</span></td>
        <td><span class="badge s-{{this.paymentStatus}}">{{this.paymentStatus}}</span></td>
        <td>{{this.totalPrice}}</td>
        <td>
          {{#if this.active}}
            <form class="inline" method="post" action="/admin/reservations/{{this.id}}?_method=PUT">
              <select name="roomId" style="width:120px">
                {{#each ../rooms}}
                  <option value="{{this.id}}" {{selected this.id ../roomId}}>{{this.name}}</option>
                {{/each}}
              </select>
              <input name="checkIn" type="date" value="{{this.checkIn}}" required />
              <input name="checkOut" type="date" value="{{this.checkOut}}" required />
              <button type="submit">Save</button>
            </form>
          {{else}}
            <span class="muted">{{this.roomName}} · {{this.checkIn}} → {{this.checkOut}}</span>
          {{/if}}
        </td>
        <td>
          {{#if this.active}}
            <form method="post" action="/admin/reservations/{{this.id}}/cancel" onsubmit="return confirm('Cancel this reservation?')">
              <button class="danger" type="submit">Cancel</button>
            </form>
          {{/if}}
        </td>
      </tr>
    {{else}}
      <tr><td colspan="7" class="muted">No reservations found.</td></tr>
    {{/each}}
  </tbody>
</table>

{{> footer}}
